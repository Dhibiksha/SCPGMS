# SCPGMS Backend Environment Variables Example

# Port to listen on (Render sets PORT automatically)
PORT=5000

# Node Environment
NODE_ENV=production

# Database Connection URL (PostgreSQL for Render production, SQLite for local dev)
# PostgreSQL Example: postgresql://username:password@ep-sample-123456.us-east-1.aws.neon.tech/scpgms_db?sslmode=require
DATABASE_URL="postgresql://scpgms_user:YOUR_POSTGRES_PASSWORD@YOUR_RENDER_POSTGRES_HOST:5432/scpgms_db?sslmode=require"

# JWT Secret Key for Session Authentication (Generate a strong random string in production)
JWT_SECRET="generate-a-secure-random-jwt-secret-key-min-32-chars"

# Allowed CORS Origins (comma separated list of deployed frontend URLs, e.g. https://scpgms-frontend.onrender.com)
CORS_ORIGIN="https://scpgms-frontend.onrender.com"

# Google OAuth 2.0 Client ID (Required for Google Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# Authorized JavaScript Origins: http://localhost:5173 (and production frontend URL)
# Authorized Redirect URIs: http://localhost:5173
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
