# SCPGMS Frontend Environment Variables Example
# Set VITE_API_URL to your deployed backend service URL on Render (e.g. https://scpgms-backend.onrender.com/api)
# Leave empty or omitted during local dev to use Vite local proxy (/api -> http://localhost:5000)

VITE_API_URL=
# Google OAuth 2.0 Client ID for Frontend Web App (Must match the Client ID configured in Google Cloud Console)
# Leave empty or set to your client ID:
VITE_GOOGLE_CLIENT_ID=432843214682-c0ae41ap5hla2jmunm8rtahq7j6n39ft.apps.googleusercontent.com